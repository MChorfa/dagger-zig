# Local testing environment variables
# Copy to .env.local and fill in real values for local workflow testing
#
# NOTE: GITHUB_TOKEN is auto-detected from 'gh CLI' if authenticated
# Run 'gh auth login' to authenticate - no need to set manually
# Run 'make auth-status' to check authentication status

# GitHub token (optional - auto-detected from gh CLI)
# GITHUB_TOKEN=ghp_your_token_here

# GitLab token (optional - auto-detected from glab CLI)
# GITLAB_TOKEN=glpat-your_token_here

# Dagger Cloud (optional - for CI pipeline testing)
DAGGER_CLOUD_TOKEN=dagger_cloud_token_here

# Cosign/Sigstore (for local signing testing)
# COSIGN_PASSWORD=password_here

# FOSSA API key (for license scanning)
# FOSSA_API_KEY=your_fossa_key

# GitLeaks license (for secret scanning)
# GITLEAKS_LICENSE=your_gitleaks_license

# OpenTelemetry (for observability testing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=dagger-zig-local

# Test flags
CI=true
LOCAL_TEST=true
